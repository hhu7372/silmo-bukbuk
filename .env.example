# ── 배포 환경 변수 (Vercel: Project → Settings → Environment Variables) ──
# 배포 주소 (공유 미리보기 og:image / canonical). 끝에 / 없이.
SITE_URL=https://your-domain.example
# 문의 이메일 (개인정보 처리방침·문의하기 화면에 표시, 폼 주소가 없을 때 메일 앱으로 연결)
CONTACT_EMAIL=you@example.com
# Google AdSense 게시자 ID (승인 전에도 넣어야 사이트 소유 확인이 됨)
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# AdSense 광고 단위 ID (승인 후 [광고 → 광고 단위별]에서 만들기)
VITE_ADSENSE_SLOT_LEFT=
VITE_ADSENSE_SLOT_RIGHT=
VITE_ADSENSE_SLOT_MOBILE=
# 의견·문의 접수 폼 주소 (Formspree 등). 없으면 메일 앱으로 보내기로 대체
VITE_FORM_ENDPOINT=
# 안드로이드 앱(TWA) 연결 – PWABuilder 의 assetlinks.json 값
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=
