// Cloudflare Workers 정적 사이트 설정
// 대시보드의 Worker 이름(silmo-bukbuk)과 아래 name 이 같아야 합니다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silmo-bukbuk",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // 주소를 직접 입력해 들어와도 앱 화면을 보여줌
    "not_found_handling": "single-page-application"
  }
}
